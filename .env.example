# --------------------------------------------------------------------------
# SHAGAF environment variables
# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings → API). Never commit .env.local.
# --------------------------------------------------------------------------

# Public — safe to expose in the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-only. Bypasses Row Level Security. Used only by
# scripts/seed.ts, never imported by any app code. Do not prefix with
# NEXT_PUBLIC_ and do not commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password assigned to every demo account created by `npm run seed`.
# Choose your own value — at least 8 characters.
SEED_DEMO_PASSWORD=ChangeMe123!
